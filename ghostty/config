# ~/.config/ghostty/config

theme = light:Catppuccin Latte,dark:Catppuccin Mocha

font-family = UnifontExMono
font-size = 16
adjust-cell-width = -10%
alpha-blending = native
faint-opacity = 0.625

cursor-style = block

background-blur = true

mouse-scroll-multiplier = 5

clipboard-read = allow
clipboard-paste-protection = false
clipboard-trim-trailing-spaces = false
copy-on-select = false
link-previews = false

window-padding-balance = true
unfocused-split-opacity = 1
confirm-close-surface = false
quit-after-last-window-closed = false
gtk-tabs-location = bottom

keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+s=paste_from_selection
keybind = shift+insert=paste_from_selection

keybind = ctrl+shift+f2=open_config
keybind = ctrl+shift+f5=reload_config

keybind = ctrl+shift++=increase_font_size:2
keybind = ctrl+shift+-=decrease_font_size:2
keybind = ctrl+shift+backspace=reset_font_size

keybind = ctrl+shift+k=scroll_page_lines:-1
keybind = ctrl+shift+j=scroll_page_lines:1
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom
keybind = ctrl+shift+z=jump_to_prompt:-1
keybind = ctrl+shift+x=jump_to_prompt:1
keybind = ctrl+shift+h=write_scrollback_file:open

keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+right_bracket=goto_split:next
keybind = ctrl+shift+left_bracket=goto_split:previous

keybind = ctrl+shift+comma=move_tab:-1
keybind = ctrl+shift+period=move_tab:1

keybind = ctrl+shift+f11=toggle_fullscreen
keybind = ctrl+shift+f10=toggle_maximize
keybind = ctrl+shift+delete=reset

keybind = ctrl+shift+r>h=resize_split:left,10
keybind = ctrl+shift+r>j=resize_split:down,10
keybind = ctrl+shift+r>k=resize_split:up,10
keybind = ctrl+shift+r>l=resize_split:right,10
keybind = ctrl+shift+r>left=resize_split:left,10
keybind = ctrl+shift+r>down=resize_split:down,10
keybind = ctrl+shift+r>up=resize_split:up,10
keybind = ctrl+shift+r>right=resize_split:right,10
keybind = ctrl+shift+r>equal=equalize_splits